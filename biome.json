{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!dist", "!node_modules", "!.cache", "!coverage", "!bench/*.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
      "complexity": { "noExcessiveCognitiveComplexity": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  }
}
