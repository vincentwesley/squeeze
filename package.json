{
  "name": "@vins-atelier/squeeze",
  "version": "1.0.0",
  "description": "DEFLATE, zlib, gzip and PNG written from scratch in TypeScript, with a CLI and a live visualiser.",
  "author": "Vin's Atelier",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentwesley/squeeze.git"
  },
  "homepage": "https://github.com/vincentwesley/squeeze#readme",
  "keywords": [
    "deflate",
    "inflate",
    "zlib",
    "gzip",
    "png",
    "compression",
    "huffman",
    "lz77"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "bin": {
    "squeeze": "./dist/cli/squeeze.js"
  },
  "files": [
    "dist/lib",
    "dist/cli",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:lib && npm run build:cli && npm run build:web",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:cli": "node scripts/build-cli.mjs",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:corpora": "node scripts/fetch-corpora.mjs && SQUEEZE_CORPORA=1 vitest run test/corpora",
    "fuzz": "node scripts/fuzz.mjs",
    "bench": "node scripts/bench.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "serve": "node scripts/serve.mjs",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bugs": {
    "url": "https://github.com/vincentwesley/squeeze/issues"
  }
}
